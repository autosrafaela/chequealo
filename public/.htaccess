# For Single Page Application routing on Apache/LiteSpeed (Hostinger)
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical: force non-www to avoid OAuth state mismatch across origins
  RewriteCond %{HTTP_HOST} ^www\.chequealo\.ar$ [NC]
  RewriteRule ^(.*)$ https://chequealo.ar/$1 [L,R=301]

  # Pre-rendering ONLY for social media bots, allow Googlebot normal access
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|Slackbot|LinkedInBot|instagram|Pinterest|Discordbot|TelegramBot) [NC]
  RewriteCond %{HTTP_USER_AGENT} !Googlebot [NC]
  RewriteCond %{REQUEST_URI} ^/professional/
  RewriteRule ^(.*)$ https://service.prerender.io/https://chequealo.ar/$1 [P,L]

  # Serve static files directly (images, CSS, JS, sitemap, robots.txt)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other routes to the SPA entry point for Google and normal users
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: Cache static assets aggressively (adjust as needed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
